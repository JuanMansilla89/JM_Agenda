# ── Obsidian ────────────────────────────────────────────────────────────────
# Estado de sesión (machine-specific, no compartir)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace-mobile-mac.json
.obsidian/cache

# Plugins: ignorar binarios compilados, conservar data.json (configuración)
.obsidian/plugins/**/main.js
.obsidian/plugins/**/styles.css
.obsidian/plugins/**/patchedFiles.mjs
# Plugins con assets voluminosos propios
.obsidian/plugins/obsidian-advanced-slides/
.obsidian/plugins/obsidian-excalidraw-plugin/

.trash/
.DS_Store

# ── Claude Code ──────────────────────────────────────────────────────────────
.claude/

# ── Quarto ───────────────────────────────────────────────────────────────────
.quarto/
_freeze/
_site/
_output/
**/*.quarto_ipynb

# Salidas compiladas (se conserva la plantilla de referencia)
*.docx
*.pdf
!_templates/custom-reference.docx

# ── Python / Conda ───────────────────────────────────────────────────────────
.venv/
.conda/
__pycache__/
*.py[cod]

# ── Node / JavaScript ────────────────────────────────────────────────────────
**/node_modules/
**/dist/
**/dist-ssr/
nohup.out

# ── Renders self-contained (vendorizan librerías de terceros: bootstrap, tippy, etc.) ──
README.html
**/README_files/
**/*_files/libs/

# ── Editores ─────────────────────────────────────────────────────────────────
.vscode/
*.swp
*.swo

# ── Datos sensibles / temporales ─────────────────────────────────────────────
Datos Demo/
/30-Projects/Las-Bambas/Prediccion-de-mineral/Documentacion/Codigo/mockups/*

/.quarto/

# ── Graphify (regenerable, no versionar) ─────────────────────────────────────
graphify-out/
